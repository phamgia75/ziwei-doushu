# TuVi AI — copy to .env.local (never commit it). Everything is optional: with no file at all the
# app runs fully locally with Ollama at 127.0.0.1:11434 and the first suitable installed model.

# ─── Local AI (default) ───
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3.5:35b          # default: first installed from qwen3.5/qwen3/qwen2.5/gemma3/llama3…; never pulls models
# OLLAMA_NUM_CTX=16384
# AI_IDLE_TIMEOUT_MS=90000          # abort a generation if no output for this long

# ─── Optional external providers ───
# Birth-chart facts (no name, birth date or place) are sent ONLY if all three hold:
#   AI_ALLOW_EXTERNAL=true, a key below, and the user selects the provider + consents in Cài đặt.
# AI_ALLOW_EXTERNAL=false
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# ─── Knowledge sources ───
# DATASET_DIR=data/dataset/v4.0     # filled by: npm run dataset:fetch (CC BY 4.0, ~161 MB)
# RAG_INCLUDE_NC=false              # true = also retrieve Ni Haixia quotes (CC BY-NC-SA 4.0, non-commercial only)

# ─── Server ───
# ALLOWED_HOSTS=localhost,127.0.0.1,[::1]   # Host-header allow-list (DNS-rebinding protection)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
